{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Globales Basis-Preset für alle Repositories von NicoGartmann",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "automerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Major-Updates optisch durch ein eigenes Label hervorheben",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-update"
      ]
    }
  ]
}
